# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real passwords and must never be committed or shared.
# Generate each password/secret with:      openssl rand -base64 32

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME="The Fireside"

# Unique per website. Names this site's containers, network and database volume.
# Lowercase letters, numbers, dashes and underscores only, e.g. the domain without dots.
COMPOSE_PROJECT_NAME=thefireside

# --- Ports -------------------------------------------------------------------
# The port the VPS-level Nginx forwards this domain to. Must be unique per website on the VPS.
FRONTEND_PORT=8102

# Internal only (never public). If you change it, change it in frontend/nginx/default.conf too.
BACKEND_PORT=3000

# How many proxies sit in front of the API: 2 on the VPS (VPS Nginx + frontend Nginx).
TRUST_PROXY=2

# --- Database ----------------------------------------------------------------
MYSQL_DATABASE=thefireside
MYSQL_USER=thefireside
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# The database's Docker service name and port. Leave as they are.
DB_HOST=database
DB_PORT=3306

# --- Project-specific: reservation emails ------------------------------------
# When a table request comes in, it is saved in the database and, if SMTP is set, emailed to MAIL_TO
# and acknowledged to the guest. Leave SMTP_HOST empty to only save requests (nobody gets an email).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Fireside <no-reply@thefireside.co.za>"
# Who receives new table requests (the restaurant).
MAIL_TO=Debbie@thefireside.co.za
RESTAURANT_PHONE="066 210 5819"

# --- Deployment (set on the VPS by deploy/deploy.sh; leave unset on your computer) ---
# The exact images to run, e.g. ghcr.io/<owner>/<repo>-frontend:sha-<commit>. Unset = build locally.
# FRONTEND_IMAGE=
# BACKEND_IMAGE=
